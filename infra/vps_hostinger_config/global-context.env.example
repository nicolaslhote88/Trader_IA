# Valeurs sûres par défaut : collecte World Monitor et consommation AG1 désactivées.
WORLD_MONITOR_ENABLED=false
WORLD_MONITOR_MODE=mcp
WORLD_MONITOR_BASE_URL=https://worldmonitor.app/mcp
WORLD_MONITOR_API_KEY=
WORLD_MONITOR_TIMEOUT_SECONDS=30
WORLD_MONITOR_MAX_RETRIES=2

MACRO_DUCKDB_PATH=/files/duckdb/macro_data.duckdb
WORLD_MONITOR_DUCKDB_PATH=/files/duckdb/worldmonitor_v1.duckdb
GLOBAL_CONTEXT_DUCKDB_PATH=/files/duckdb/global_context_v1.duckdb

GLOBAL_CONTEXT_ENABLED=false
GLOBAL_CONTEXT_ADVISORY_ONLY=true
GLOBAL_CONTEXT_FAIL_OPEN=true
GLOBAL_CONTEXT_MAX_AGE_HOURS=12

AG1_GLOBAL_CONTEXT_MAX_CHARS=12000
AG1_GLOBAL_CONTEXT_TOP_EVENTS_MAX=5
AG1_GLOBAL_CONTEXT_TOP_SECTORS_MAX=8
AG1_GLOBAL_CONTEXT_TOP_ASSETS_MAX=12

AG9_DEFAULT_EVENT_HALF_LIFE_HOURS=72
AG9_SOURCE_DIVERSITY_MIN=2
AG9_MIN_CONFIDENCE=0.35
AG9_CRITICAL_SCORE_THRESHOLD=0.65
