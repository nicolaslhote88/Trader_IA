# ============================================================
# Trader_IA — Template .env pour le VPS Hostinger
# Copier ce fichier en .env puis compléter chaque valeur.
# NE JAMAIS COMMIT LE .env RÉEL.
# ============================================================

# --- Traefik / TLS -------------------------------------------
SSL_EMAIL=you@example.com
GENERIC_TIMEZONE=Europe/Paris

# --- Domain n8n ----------------------------------------------
SUBDOMAIN=n8n
DOMAIN_NAME=example.com
# URL publique finale: https://${SUBDOMAIN}.${DOMAIN_NAME}

# --- n8n task runners ----------------------------------------
# Doit être identique entre le service n8n et les task-runners.
# Générer une valeur forte: `openssl rand -hex 32`
N8N_RUNNERS_AUTH_TOKEN=replace_me_with_a_strong_random_value

# --- Transcript API (service externe) ------------------------
TRANSCRIPT_API_BASE=https://transcript.example.com

# --- Google Sheets (dashboard / legacy) ----------------------
GOOGLE_SHEET_ID=1AbCDeFGhIjKlMnOpQrStUvWxYz

# --- Trading dashboard (Streamlit) ---------------------------
DASHBOARD_DOMAIN=dashboard.example.com
# Hash Basic Auth pour Traefik middleware.
# Générer: `htpasswd -nb admin 'motdepasse' | sed -e s/\\$/\\$\\$/g`
DASHBOARD_BASIC_AUTH=admin:$$apr1$$xxxxxxxx$$yyyyyyyyyyyyyyyyyyyyy


# --- IBKR Client Portal API Gateway --------------------------
# true  = dry-run (log seulement, aucun ordre réel) — DÉFAUT recommandé au démarrage
# false = live (ordres envoyés à IBKR) — ne passer à false qu'après validation dry-run
IBKR_DRY_RUN=true

# false = les nodes n8n restent sandbox-only quand IBKR_DRY_RUN=true.
# true  = les nodes appellent quand meme ibkr-broker, qui repond en dry-run.
IBKR_SEND_DRY_RUN_TO_BROKER=false

# Garde-fou paper et reconciliation cash Forex
IBKR_REQUIRE_PAPER_ACCOUNT=true
IBKR_PAPER_ACCOUNT_PREFIXES=DU
IBKR_RECONCILE_CASH_BALANCES=true
IBKR_BLOCK_ON_CASH_DIVERGENCE=false
IBKR_CASH_RECON_THRESHOLD_UNITS=5
# Budget court du noeud AG1-FX d'envoi IBKR: n8n coupe les Code nodes a 60s.
IBKR_FILL_CONFIRM_SECONDS=6
IBKR_FILL_POLL_INTERVAL_SECONDS=2
IBKR_SEND_NODE_TIME_BUDGET_SECONDS=50
AG1_FX_PORTFOLIO_BASE_CCY=EUR
# true = en paper live CPAPI, AG1-FX ne tente que des nouvelles ouvertures
# financées par la devise de base du portefeuille; cela évite les rejets
# IBKR "FX trade would expose account to currency leverage".
AG1_FX_CASH_ONLY_BASE_CCY_MODE=true

# ID du compte IBKR (auto-détecté si vide, mais mieux de le fixer)
# Visible dans le portail IBKR > Account Settings > Account ID
IBKR_ACCOUNT_ID=

# URL interne du gateway CPAPI (ne pas modifier si même docker-compose)
# IBKR_GATEWAY_URL=https://ibkr-gateway:5000

# --- Robustesse session IBKR -------------------------------
# Le broker appelle /tickle toutes les ~55s puis tente /iserver/auth/ssodh/init
# si la session brokerage tombe mais que la session Gateway/SSO reste valide.
IBKR_KEEPALIVE_INTERVAL_SECONDS=55
IBKR_AUTO_REAUTH_ENABLED=true
# true peut deconnecter une session IBKR concurrente sur le meme username.
# A n'activer que pour un username dedie au robot.
IBKR_AUTO_REAUTH_COMPETE=false

# Alerte optionnelle quand IBKR impose un relogin navigateur/2FA.
# Laisser vide si aucun webhook n'est branche.
IBKR_ALERT_WEBHOOK_URL=
IBKR_ALERT_COOLDOWN_SECONDS=900

# Instructions exposees par /auth/operator-action et /health quand une action
# humaine est necessaire.
IBKR_LOGIN_URL=https://localhost:5000
IBKR_LOGIN_TUNNEL_COMMAND=ssh -L 5000:127.0.0.1:5000 root@100.104.236.78

# Mode experimental : indique au broker que des credentials d'assistance sont
# presents. Le Client Portal Gateway IBKR peut encore demander le 2FA.
# Ne pas versionner de vrais identifiants.
IBKR_ASSISTED_LOGIN_ENABLED=false
IBKR_USERNAME=
IBKR_PASSWORD=
IBEAM_ACCOUNT=
IBEAM_PASSWORD=
IBEAM_LOG_LEVEL=INFO
IBEAM_LOG_TO_FILE=True
IBEAM_ERROR_SCREENSHOTS=True
IBEAM_GATEWAY_BASE_URL=https://localhost:5000
IBEAM_MAINTENANCE_INTERVAL=60
# Garde-fou lockout IBKR : evite des retries infinis si credentials/2FA KO.
IBEAM_MAX_FAILED_AUTH=3
IBEAM_RESTART_FAILED_SESSIONS=True
